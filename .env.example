DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
# Required: GUILD_ID for guild-only slash command registration (comma-separate multiple guild IDs).
# Commands are NEVER registered globally; the bot skips registration if this is empty.
GUILD_ID=your_test_guild_id_here
MONGODB_URI=mongodb://localhost:27017/discord_bot
